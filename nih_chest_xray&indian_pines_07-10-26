in files:\n","        BASE_EXEC_DIR = root\n","        break\n","print(f\"Thư mục làm việc chính: {BASE_EXEC_DIR}\")"]},{"cell_type":"code","execution_count":2,"id":"fc3efd3d","metadata":{"execution":{"iopub.execute_input":"2026-10-07T04:17:19.870756Z","iopub.status.busy":"2026-10-07T04:17:19.870657Z","iopub.status.idle":"2026-10-07T04:19:05.690265Z","shell.execute_reply":"2026-10-07T04:19:05.690006Z"},"papermill":{"duration":105.821767,"end_time":"2026-10-07T04:19:05.69089+00:00","exception":false,"start_time":"2026-10-07T04:17:19.869123+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["\n","--- 4. XỬ LÝ 3 DATASETS MỚI (MSTAR / NIH / INDIAN PINES) ---\n","Đang xử lý MSTAR từ: /kaggle/input/datasets/ravenchencn/mstar-10-classes/MSTAR-10-Classes\n","   Đã loại bỏ các lớp ngoài chuẩn SOC-10: ['SLICY']\n","   MSTAR: train = 10 lớp / 2747 ảnh | test = 10 lớp / 2425 ảnh -> ✅ CHUẨN (kỳ vọng 10 lớp)\n","✅ Xử lý xong MSTAR (10 lớp chuẩn).\n","Đang xử lý NIH Chest X-ray từ: /kaggle/input/datasets/nih-chest-xrays/data\n","   Tìm thấy 112120 ảnh PNG.\n"]},{"name":"stderr","output_type":"stream","text":["Gán nhãn NIH: 100%|█████████████████| 112120/112120 [00:00<00:00, 237818.97it/s]\n"]},{"name":"stdout","output_type":"stream","text":["   Bỏ qua 81157 ảnh (No Finding / đa nhãn / ngoài split), thiếu file: 0.\n","   NIH Chest X-ray: train = 14 lớp / 22971 ảnh | test = 14 lớp / 7992 ảnh -> ✅ CHUẨN (kỳ vọng 14 lớp)\n","✅ Xử lý xong NIH Chest X-ray (14 lớp bệnh lý).\n","Đang xử lý Indian Pines...\n","   Nguồn: GeoTIFF Purdue (Site3.tif + Site3_gr.tif)\n","   Data (145, 145, 220), GT (145, 145), 16 lớp, 10366 pixel có nhãn.\n","   Indian Pines: train = 16 lớp / 8292 ảnh | test = 16 lớp / 2074 ảnh -> ✅ CHUẨN (kỳ vọng 16 lớp)\n","✅ Xử lý xong Indian Pines (16 lớp).\n","\n","--- TỔNG KẾT 3 DATASETS MỚI ---\n","   MSTAR: train = 10 lớp / 2747 ảnh | test = 10 lớp / 2425 ảnh -> ✅ CHUẨN (kỳ vọng 10 lớp)\n","   NIH Chest X-ray: train = 14 lớp / 22971 ảnh | test = 14 lớp / 7992 ảnh -> ✅ CHUẨN (kỳ vọng 14 lớp)\n","   Indian Pines: train = 16 lớp / 8292 ảnh | test = 16 lớp / 2074 ảnh -> ✅ CHUẨN (kỳ vọng 16 lớp)\n","\n","--- ĐỒNG BỘ THƯ MỤC DATA VỚI CODEBASE ---\n","✅ Đã symlink: /kaggle/working/data -> /kaggle/working/GOD-Improvement/GOD/GOD/data\n","\n","--- KIỂM TRA ĐƯỜNG DẪN 3 DATASETS MỚI ---\n","   mstar          : ./data/mstar/train -> ✅ SẴN SÀNG\n","   nih_chest_xray : ./data/nih_chest_xray/train -> ✅ SẴN SÀNG\n","   indian_pines   : ./data/indian_pines/train -> ✅ SẴN SÀNG\n"]}],"source":["# Cell 2.1\n","# ======================================================================\n","# 4. XỬ LÝ 3 DATASETS MỚI: MSTAR / NIH CHEST X-RAY / INDIAN PINES\n","#    - Mỗi bộ chỉ được coi là \"sẵn sàng\" khi có file đánh dấu .prepared_ok\n","#      VÀ số lớp train/test đúng chuẩn. Nếu không -> tự xoá bản cũ & dựng lại.\n","#    - Kaggle links:\n","#      MSTAR       : https://www.kaggle.com/datasets/ravenchencn/mstar-10-classes\n","#      NIH         : https://www.kaggle.com/datasets/nih-chest-xrays/data\n","#      Indian Pines: https://www.kaggle.com/datasets/ankitgaidhar/indian-pines-hyperspectral-dataset\n","# ======================================================================\n","import shutil\n","import numpy as np\n","\n","\n","import os\n","import subprocess\n","import scipy.io\n","import glob\n","import re\n","from tqdm import tqdm\n","\n","# Đảm bảo đường dẫn thực thi đã được định vị\n","if 'BASE_EXEC_DIR' not in globals():\n","    BASE_EXEC_DIR = \"/kaggle/working/GOD-Improvement/GOD\"\n","\n","# Các đường dẫn gốc (Tự động tìm hoặc dùng fix cứng)\n","DATA_INPUT = None\n","for root, dirs, _ in os.walk(\"/kaggle/input\"):\n","    if \"god-data-weights\" in dirs:\n","        DATA_INPUT = os.path.join(root, \"god-data-weights\")\n","        break\n","if not DATA_INPUT: DATA_INPUT = \"/kaggle/input/datasets/hinam74/god-data-weights\"\n","\n","WORK_DATA_DIR = \"/kaggle/working/data\"\n","os.makedirs(WORK_DATA_DIR, exist_ok=True)\n","\n","print(\"\\n--- 4. XỬ LÝ 3 DATASETS MỚI (MSTAR / NIH / INDIAN PINES) ---\")\n","\n","KAGGLE_INPUT = \"/kaggle/input\"\n","READY_FLAG = \".prepared_ok\"\n","IMG_EXTS = ('.jpg', '.jpeg', '.png', '.bmp', '.tif', '.tiff')\n","PRUNE_DIRS = {\"train\", \"test\", \"val\", \"valid\", \"images\"}   # không đi sâu vào các thư mục ảnh lớn khi dò tìm\n","\n","\n","def _reset_dir(path):\n","    \"\"\"Xoá sạch thư mục / symlink cũ (KHÔNG đụng tới dữ liệu gốc trong /kaggle/input).\"\"\"\n","    if os.path.islink(path):\n","        os.unlink(path)\n","    elif os.path.isdir(path):\n","        shutil.rmtree(path)\n","\n","\n","def _walk_limited(root, max_depth):\n","    \"\"\"os.walk có giới hạn độ sâu và bỏ qua các thư mục chứa hàng chục nghìn ảnh.\"\"\"\n","    root = root.rstrip(os.sep)\n","    base_depth = root.count(os.sep)\n","    for cur, dirs, files in os.walk(root):\n","        yield cur, dirs, files\n","        if cur.count(os.sep) - base_depth >= max_depth:\n","            dirs[:] = []\n","        else:\n","            dirs[:] = [d for d in dirs if d.lower() not in PRUNE_DIRS and not d.lower().startswith(\"images_\")]\n","\n","\n","def _find_dirs_by_keyword(keywords, max_depth=4):\n","    found = []\n","    for cur, dirs, _ in _walk_limited(KAGGLE_INPUT, max_depth):\n","        for d in dirs:\n","            if any(k in d.lower() for k in keywords):\n","                found.append(os.path.join(cur, d))\n","    return found\n","\n","\n","def _split_summary(root):\n","    out = {}\n","    for split in (\"train\", \"test\"):\n","        d = os.path.join(root, split)\n","        if not os.path.isdir(d):\n","            out[split] = (0, 0)\n","            continue\n","        classes = [c for c in os.listdir(d) if os.path.isdir(os.path.join(d, c))]\n","        n_imgs = sum(1 for c in classes for f in os.listdir(os.path.join(d, c)) if f.lower().endswith(IMG_EXTS))\n","        out[split] = (len(classes), n_imgs)\n","    return out\n","\n","\n","def _check(root, expected_cls):\n","    s = _split_summary(root)\n","    ok = (s[\"train\"][0] == expected_cls and s[\"test\"][0] == expected_cls\n","          and s[\"train\"][1] > 0 and s[\"test\"][1] > 0)\n","    return ok, s\n","\n","\n","def _report(name, root, expected_cls):\n","    ok, s = _check(root, expected_cls)\n","    flag = \"✅ CHUẨN\" if ok else \"❌ SAI\"\n","    print(f\"   {name}: train = {s['train'][0]} lớp / {s['train'][1]} ảnh | \"\n","          f\"test = {s['test'][0]} lớp / {s['test'][1]} ảnh -> {flag} (kỳ vọng {expected_cls} lớp)\")\n","    return ok\n","\n","\n","def _is_ready(root, expected_cls):\n","    return os.path.isfile(os.path.join(root, READY_FLAG)) and _check(root, expected_cls)[0]\n","\n","\n","def _mark_ready(root):\n","    with open(os.path.join(root, READY_FLAG), \"w\") as f:\n","        f.write(\"ok\")\n","\n","\n","def _safe_symlink(src, dst_dir, fname, prefix=\"\"):\n","    dst = os.path.join(dst_dir, fname)\n","    if os.path.lexists(dst):                      # trùng tên -> thêm tiền tố\n","        dst = os.path.join(dst_dir, f\"{prefix}_{fname}\")\n","    if not os.path.lexists(dst):\n","        os.symlink(src, dst)\n","\n","\n","# ----------------------------------------------------------------------\n","# 4.1. MSTAR (SOC 10 lớp: train = 17°, test = 15°)\n","#      Bản Kaggle thực chất có 11 lớp (thêm SLICY - mục tiêu hiệu chuẩn,\n","#      không phải phương tiện) -> loại bỏ SLICY để còn đúng 10 lớp chuẩn.\n","# ----------------------------------------------------------------------\n","MSTAR_CLASSES = [\"2S1\", \"BMP2\", \"BRDM2\", \"BTR60\", \"BTR70\", \"D7\", \"T62\", \"T72\", \"ZIL131\", \"ZSU234\"]\n","\n","\n","def _canon(name):\n","    return re.sub(r'[^A-Z0-9]', '', name.upper())   # \"BRDM_2\" -> \"BRDM2\", \"ZSU_23_4\" -> \"ZSU234\"\n","\n","\n","def _find_mstar_root():\n","    roots = _find_dirs_by_keyword([\"mstar\"]) or [KAGGLE_INPUT]\n","    fallback = (None, None)\n","    for base in roots:\n","        for cur, dirs, _ in _walk_limited(base, 6):\n","            low = {d.lower(): d for d in dirs}\n","            if \"train\" in low and \"test\" in low:\n","                tr, te = os.path.join(cur, low[\"train\"]), os.path.join(cur, low[\"test\"])\n","                names = {_canon(c) for c in os.listdir(tr) if os.path.isdir(os.path.join(tr, c))}\n","                if set(MSTAR_CLASSES) <= names:\n","                    return tr, te\n","                if len(names) >= 10 and fallback[0] is None:\n","                    fallback = (tr, te)\n","    return fallback\n","\n","\n","mstar_processed = os.path.join(WORK_DATA_DIR, \"mstar\")\n","if _is_ready(mstar_processed, 10):\n","    print(\"✅ MSTAR đã sẵn sàng.\")\n","else:\n","    _reset_dir(mstar_processed)\n","    mstar_train_src, mstar_test_src = _find_mstar_root()\n","    if mstar_train_src is None:\n","        print(\"⚠️ Không tìm thấy MSTAR (cần thư mục train/test chứa đủ 10 lớp). Hãy '+ Add Input' ravenchencn/mstar-10-classes.\")\n","    else:\n","        print(f\"Đang xử lý MSTAR từ: {os.path.dirname(mstar_train_src)}\")\n","        all_names = {_canon(c) for c in os.listdir(mstar_train_src) if os.path.isdir(os.path.join(mstar_train_src, c))}\n","        use_whitelist = set(MSTAR_CLASSES) <= all_names\n","        skipped = set()\n","        for split, src in ((\"train\", mstar_train_src), (\"test\", mstar_test_src)):\n","            for c in sorted(os.listdir(src)):\n","                cls_src = os.path.join(src, c)\n","                if not os.path.isdir(cls_src):\n","                    continue\n","                cname = _canon(c)\n","                if \"SLICY\" in cname or (use_whitelist and cname not in MSTAR_CLASSES):\n","                    skipped.add(c)\n","                    continue\n","                cls_dst = os.path.join(mstar_processed, split, cname)\n","                os.makedirs(cls_dst, exist_ok=True)\n","                for r, _, files in os.walk(cls_src):          # hỗ trợ cả lớp có thư mục con (biến thể serial)\n","                    for f in files:\n","                        if f.lower().endswith(IMG_EXTS):\n","                            _safe_symlink(os.path.join(r, f), cls_dst, f, prefix=os.path.basename(r))\n","        if skipped:\n","            print(f\"   Đã loại bỏ các lớp ngoài chuẩn SOC-10: {sorted(skipped)}\")\n","        if _report(\"MSTAR\", mstar_processed, 10):\n","            _mark_ready(mstar_processed)\n","            print(\"✅ Xử lý xong MSTAR (10 lớp chuẩn).\")\n","\n","\n","# ----------------------------------------------------------------------\n","# 4.2. NIH Chest X-ray (14 lớp bệnh lý)\n","#      - Bỏ \"No Finding\" (không phải bệnh lý) -> đúng 14 lớp như utils/data.py.\n","#      - Dùng split CHÍNH THỨC train_val_list.txt / test_list.txt (chia theo bệnh nhân).\n","#      - NIH_SINGLE_LABEL_ONLY = True : chỉ lấy ảnh có đúng 1 nhãn bệnh (chuẩn\n","#        khi biến bài toán multi-label thành multi-class, không nhiễu nhãn).\n","#        Đặt False để giữ thêm ảnh đa nhãn (gán theo nhãn bệnh đầu tiên).\n","# ----------------------------------------------------------------------\n","NIH_CLASSES = [\"Atelectasis\", \"Cardiomegaly\", \"Consolidation\", \"Edema\", \"Effusion\", \"Emphysema\", \"Fibrosis\",\n","               \"Hernia\", \"Infiltration\", \"Mass\", \"Nodule\", \"Pleural_Thickening\", \"Pneumonia\", \"Pneumothorax\"]\n","NIH_SINGLE_LABEL_ONLY = True\n","\n","\n","def _find_nih_csv():\n","    roots = _find_dirs_by_keyword([\"nih\", \"chest\", \"xray\", \"x-ray\"]) + [KAGGLE_INPUT]\n","    for base in roots:\n","        for cur, _, files in _walk_limited(base, 5):\n","            for f in files:\n","                if f.lower().startswith(\"data_entry\") and f.lower().endswith(\".csv\"):\n","                    return os.path.join(cur, f)\n","    return None\n","\n","\n","nih_processed = os.path.join(WORK_DATA_DIR, \"nih_chest_xray\")\n","if _is_ready(nih_processed, 14):\n","    print(\"✅ NIH Chest X-ray đã sẵn sàng.\")\n","else:\n","    _reset_dir(nih_processed)\n","    nih_csv = _find_nih_csv()\n","    if nih_csv is None:\n","        print(\"⚠️ Không tìm thấy Data_Entry_2017.csv. Hãy '+ Add Input' nih-chest-xrays/data.\")\n","    else:\n","        import pandas as pd\n","        nih_root = os.path.dirname(nih_csv)\n","        print(f\"Đang xử lý NIH Chest X-ray từ: {nih_root}\")\n","\n","        # a) Bản đồ tên ảnh -> đường dẫn (images_001 ... images_012)\n","        img_map = {}\n","        for r, _, files in os.walk(nih_root):\n","            for f in files:\n","                if f.lower().endswith(\".png\"):\n","                    img_map[f] = os.path.join(r, f)\n","        print(f\"   Tìm thấy {len(img_map)} ảnh PNG.\")\n","\n","        # b) Split chính thức\n","        def _read_list(fname):\n","            for r, _, files in _walk_limited(nih_root, 2):\n","                if fname in files:\n","                    with open(os.path.join(r, fname)) as fh:\n","                        return set(x.strip() for x in fh if x.strip())\n","            return None\n","        train_set, test_set = _read_list(\"train_val_list.txt\"), _read_list(\"test_list.txt\")\n","        if train_set is None or test_set is None:\n","            print(\"   ⚠️ Thiếu train_val_list.txt/test_list.txt -> chia 80/20 theo BỆNH NHÂN (seed 1993).\")\n","            df_tmp = pd.read_csv(nih_csv, usecols=[\"Image Index\"])\n","            patients = sorted({x.split(\"_\")[0] for x in df_tmp[\"Image Index\"]})\n","            rng = np.random.RandomState(1993)\n","            rng.shuffle(patients)\n","            test_patients = set(patients[int(len(patients) * 0.8):])\n","            test_set = {x for x in df_tmp[\"Image Index\"] if x.split(\"_\")[0] in test_patients}\n","            train_set = set(df_tmp[\"Image Index\"]) - test_set\n","\n","        # c) Gán nhãn & tạo symlink\n","        nih_set = set(NIH_CLASSES)\n","        for split in (\"train\", \"test\"):\n","            for c in NIH_CLASSES:\n","                os.makedirs(os.path.join(nih_processed, split, c), exist_ok=True)\n","\n","        df = pd.read_csv(nih_csv, usecols=[\"Image Index\", \"Finding Labels\"])\n","        n_missing, n_skipped = 0, 0\n","        for img, finding in tqdm(zip(df[\"Image Index\"], df[\"Finding Labels\"]), total=len(df),\n","                                 desc=\"Gán nhãn NIH\", ncols=80):\n","            raw = [l.strip() for l in str(finding).split(\"|\")]\n","            if NIH_SINGLE_LABEL_ONLY:\n","                if len(raw) != 1 or raw[0] not in nih_set:\n","                    n_skipped += 1\n","                    continue\n","                lbl = raw[0]\n","            else:\n","                diseases = [l for l in raw if l in nih_set]\n","                if not diseases:\n","                    n_skipped += 1\n","                    continue\n","                lbl = diseases[0]\n","            if img in test_set:\n","                split = \"test\"\n","            elif img in train_set:\n","                split = \"train\"\n","            else:\n","                n_skipped += 1\n","                continue\n","            src = img_map.get(img)\n","            if src is None:\n","                n_missing += 1\n","                continue\n","            dst = os.path.join(nih_processed, split, lbl, img)\n","            if not os.path.lexists(dst):\n","                os.symlink(src, dst)\n","        print(f\"   Bỏ qua {n_skipped} ảnh (No Finding / đa nhãn / ngoài split), thiếu file: {n_missing}.\")\n","        if _report(\"NIH Chest X-ray\", nih_processed, 14):\n","            _mark_ready(nih_processed)\n","            print(\"✅ Xử lý xong NIH Chest X-ray (14 lớp bệnh lý).\")\n","\n","\n","# ----------------------------------------------------------------------\n","# 4.3. Indian Pines (16 lớp, ảnh 145x145, 200/220 băng phổ)\n","#      Bản Kaggle (Purdue bundle) KHÔNG có .mat mà là GeoTIFF:\n","#        bundle/aviris_hyperspectral_data/19920612_AVIRIS_IndianPine_Site3.tif      (145x145x220)\n","#        documentation/.../19920612_AVIRIS_IndianPine_Site3_gr.tif                   (ground truth)\n","#      Thứ tự nguồn: (1) .mat có sẵn trong input -> (2) GeoTIFF Kaggle -> (3) tải .mat từ EHU.\n","#      Mỗi pixel có nhãn -> 1 patch (IP_PATCH_SIZE x IP_PATCH_SIZE, pad reflect nên giữ\n","#      ĐỦ mọi pixel kể cả ở biên) -> resize 224x224. Chia stratified theo lớp, seed cố định.\n","# ----------------------------------------------------------------------\n","IP_PATCH_SIZE = 9\n","IP_TRAIN_RATIO = 0.8\n","IP_SEED = 1993\n","\n","\n","def _read_tif(path):\n","    try:\n","        import tifffile\n","        return np.squeeze(np.asarray(tifffile.imread(path)))\n","    except Exception:\n","        pass\n","    try:\n","        import rasterio\n","        with rasterio.open(path) as src:\n","            return np.squeeze(np.transpose(src.read(), (1, 2, 0)))\n","    except Exception:\n","        pass\n","    from PIL import Image\n","    return np.squeeze(np.array(Image.open(path)))\n","\n","\n","def _gt_to_2d(y):\n","    \"\"\"GT dạng ảnh màu (palette RGB) -> nhãn số nguyên, nền đen = 0.\"\"\"\n","    if y.ndim == 2:\n","        return y.astype(np.int64)\n","    flat = y.reshape(-1, y.shape[-1])\n","    uniq, inv = np.unique(flat, axis=0, return_inverse=True)\n","    inv = inv.reshape(y.shape[:2]) + 1\n","    bg = np.where((uniq == 0).all(axis=1))[0]\n","    if len(bg):\n","        inv[inv == bg[0] + 1] = 0\n","    return inv.astype(np.int64)\n","\n","\n","def _load_ip_from_mats(mat_paths):\n","    from scipy.io import loadmat\n","    cubes, gts = [], []\n","    for p in mat_paths:\n","        try:\n","            m = loadmat(p)\n","        except Exception:\n","            continue\n","        for k, v in m.items():\n","            if k.startswith(\"__\") or not isinstance(v, np.ndarray):\n","                continue\n","            if v.ndim == 3:\n","                cubes.append((\"corrected\" in p.lower(), v))\n","            elif v.ndim == 2 and min(v.shape) > 1:\n","                gts.append((\"gt\" in p.lower(), v))\n","    if not cubes or not gts:\n","        return None, None\n","    cubes.sort(key=lambda t: t[0], reverse=True)   # ưu tiên bản \"corrected\" (200 băng)\n","    gts.sort(key=lambda t: t[0], reverse=True)\n","    return cubes[0][1], gts[0][1]\n","\n","\n","def _load_ip_from_tifs(ip_files):\n","    data_tif = next((p for p in ip_files if os.path.basename(p).lower().endswith(\"site3.tif\")), None)\n","    gt_tif = next((p for p in ip_files if os.path.basename(p).lower().endswith(\"site3_gr.tif\")), None)\n","    if not data_tif or not gt_tif:\n","        return None, None\n","    return _read_tif(data_tif), _gt_to_2d(_read_tif(gt_tif))\n","\n","\n","def _download_ip_mats():\n","    import urllib.request\n","    import ssl\n","    ssl._create_default_https_context = ssl._create_unverified_context\n","    tmp = os.path.join(WORK_DATA_DIR, \"ip_temp\")\n","    os.makedirs(tmp, exist_ok=True)\n","    sources = [\n","        (\"http://www.ehu.eus/ccwintco/uploads/6/67/Indian_pines_corrected.mat\",\n","         \"http://www.ehu.eus/ccwintco/uploads/c/c4/Indian_pines_gt.mat\"),\n","        (\"https://www.ehu.eus/ccwintco/uploads/6/67/Indian_pines_corrected.mat\",\n","         \"https://www.ehu.eus/ccwintco/uploads/c/c4/Indian_pines_gt.mat\"),\n","    ]\n","    data_mat = os.path.join(tmp, \"Indian_pines_corrected.mat\")\n","    gt_mat = os.path.join(tmp, \"Indian_pines_gt.mat\")\n","    for url_data, url_gt in sources:\n","        try:\n","            if not os.path.exists(data_mat):\n","                urllib.request.urlretrieve(url_data, data_mat)\n","            if not os.path.exists(gt_mat):\n","                urllib.request.urlretrieve(url_gt, gt_mat)\n","            return [data_mat, gt_mat]\n","        except Exception as e:\n","            print(f\"   Lỗi tải {url_data}: {e}\")\n","            for p in (data_mat, gt_mat):\n","                if os.path.exists(p):\n","                    os.remove(p)\n","    return []\n","\n","\n","def _build_indian_pines(X, y, dst):\n","    import cv2\n","    y = np.asarray(y).astype(np.int64)\n","    H, W = y.shape\n","    X = np.asarray(X)\n","    if X.shape[:2] != (H, W):\n","        if X.shape[1:] == (H, W):\n","            X = np.transpose(X, (1, 2, 0))           # (bands, H, W) -> (H, W, bands)\n","        else:\n","            raise ValueError(f\"Shape data {X.shape} không khớp GT {y.shape}\")\n","    n_bands = X.shape[2]\n","\n","    # Ảnh giả màu: kênh 50-27-17 (1-indexed, tổ hợp chuẩn của Purdue), giống nhau cho bản 200 & 220 băng\n","    band_idx = [49, 26, 16] if n_bands > 50 else [min(2, n_bands - 1), min(1, n_bands - 1), 0]\n","    rgb = np.stack([X[:, :, b].astype(np.float32) for b in band_idx], axis=-1)\n","    for c in range(3):\n","        lo, hi = np.percentile(rgb[:, :, c], (2, 98))\n","        rgb[:, :, c] = np.clip((rgb[:, :, c] - lo) / max(hi - lo, 1e-6), 0, 1)\n","    rgb = (rgb * 255).astype(np.uint8)\n","\n","    labels = sorted(int(v) for v in np.unique(y) if v != 0)\n","    print(f\"   Data {X.shape}, GT {y.shape}, {len(labels)} lớp, {int((y != 0).sum())} pixel có nhãn.\")\n","    if len(labels) != 16:\n","        return False\n","\n","    pad = IP_PATCH_SIZE // 2\n","    padded = np.pad(rgb, ((pad, pad), (pad, pad), (0, 0)), mode=\"reflect\")\n","    rng = np.random.RandomState(IP_SEED)\n","    for new_id, v in enumerate(labels, start=1):\n","        coords = np.argwhere(y == v)\n","        rng.shuffle(coords)\n","        n = len(coords)\n","        n_train = min(max(int(round(n * IP_TRAIN_RATIO)), 1), n - 1) if n > 1 else n\n","        for k, (i, j) in enumerate(coords):\n","            split = \"train\" if k < n_train else \"test\"\n","            patch = padded[i:i + IP_PATCH_SIZE, j:j + IP_PATCH_SIZE]\n","            patch = cv2.resize(patch, (224, 224), interpolation=cv2.INTER_CUBIC)\n","            out_dir = os.path.join(dst, split, f\"class_{new_id:02d}\")\n","            os.makedirs(out_dir, exist_ok=True)\n","            cv2.imwrite(os.path.join(out_dir, f\"{i:03d}_{j:03d}.png\"), cv2.cvtColor(patch, cv2.COLOR_RGB2BGR))\n","    return True\n","\n","\n","ip_processed = os.path.join(WORK_DATA_DIR, \"indian_pines\")\n","if _is_ready(ip_processed, 16):\n","    print(\"✅ Indian Pines đã sẵn sàng.\")\n","else:\n","    _reset_dir(ip_processed)\n","    print(\"Đang xử lý Indian Pines...\")\n","    ip_roots = _find_dirs_by_keyword([\"indian\", \"pine\"])\n","    ip_files = []\n","    for base in ip_roots:\n","        for r, _, files in os.walk(base):\n","            ip_files += [os.path.join(r, f) for f in files]\n","    ip_files = sorted(set(ip_files))\n","\n","    loaders = [\n","        (\"file .mat trong Kaggle input\", lambda: _load_ip_from_mats([p for p in ip_files if p.lower().endswith(\".mat\")])),\n","        (\"GeoTIFF Purdue (Site3.tif + Site3_gr.tif)\", lambda: _load_ip_from_tifs(ip_files)),\n","        (\"tải .mat từ EHU (cần Internet)\", lambda: _load_ip_from_mats(_download_ip_mats())),\n","    ]\n","    ip_ok = False\n","    for desc, loader in loaders:\n","        try:\n","            X_ip, y_ip = loader()\n","        except Exception as e:\n","            print(f\"   ⚠️ Lỗi đọc nguồn [{desc}]: {e}\")\n","            continue\n","        if X_ip is None:\n","            continue\n","        print(f\"   Nguồn: {desc}\")\n","        _reset_dir(ip_processed)\n","        try:\n","            ip_ok = _build_indian_pines(X_ip, y_ip, ip_processed)\n","        except Exception as e:\n","            print(f\"   ⚠️ Lỗi tạo patch: {e}\")\n","            ip_ok = False\n","        if ip_ok:\n","            break\n","        print(\"   ⚠️ Nguồn này không cho đúng 16 lớp -> thử nguồn tiếp theo.\")\n","\n","    if ip_ok and _report(\"Indian Pines\", ip_processed, 16):\n","        _mark_ready(ip_processed)\n","        print(\"✅ Xử lý xong Indian Pines (16 lớp).\")\n","    else:\n","        print(\"❌ Không dựng được Indian Pines. Kiểm tra lại input ankitgaidhar/indian-pines-hyperspectral-dataset.\")\n","\n","print(\"\\n--- TỔNG KẾT 3 DATASETS MỚI ---\")\n","_report(\"MSTAR\", mstar_processed, 10)\n","_report(\"NIH Chest X-ray\", nih_processed, 14)\n","_report(\"Indian Pines\", ip_processed, 16)\n","\n","# ======================================================================\n","# 4.4. ĐỒNG BỘ ĐƯỜNG DẪN DỮ LIỆU CHO THỰC THI (TƯƠNG TỰ 6 DATASETS TRƯỚC)\n","#      Liên kết /kaggle/working/data -> ./data tại các thư mục chạy code\n","# ======================================================================\n","import os\n","\n","print(\"\\n--- ĐỒNG BỘ THƯ MỤC DATA VỚI CODEBASE ---\")\n","\n","# Các vị trí chạy lệnh main.py trong repository GOD\n","target_exec_data_dirs = [\n","    os.path.join(BASE_EXEC_DIR, \"data\"),\n","    os.path.join(BASE_EXEC_DIR, \"GOD\", \"data\"),\n","    os.path.abspath(\"./data\")\n","]\n","\n","for target_dir in set(target_exec_data_dirs):\n","    parent = os.path.dirname(target_dir)\n","    if os.path.exists(parent):\n","        # Nếu đã tồn tại nhưng là symlink cũ/bị hỏng -> dọn dẹp trước\n","        if os.path.islink(target_dir):\n","            os.unlink(target_dir)\n","        elif os.path.isdir(target_dir) and not os.listdir(target_dir):\n","            os.rmdir(target_dir)\n","            \n","        if not os.path.exists(target_dir):\n","            try:\n","                os.symlink(WORK_DATA_DIR, target_dir)\n","                print(f\"✅ Đã symlink: {WORK_DATA_DIR} -> {target_dir}\")\n","            except Exception as e:\n","                print(f\"⚠️ Lỗi tạo symlink tới {target_dir}: {e}\")\n","\n","# Kiểm tra tính sẵn sàng của 3 dataset mới cho ImageFolder (./data/<dataset>/train)\n","print(\"\\n--- KIỂM TRA ĐƯỜNG DẪN 3 DATASETS MỚI ---\")\n","for dset in [\"mstar\", \"nih_chest_xray\", \"indian_pines\"]:\n","    train_check = os.path.join(\"./data\", dset, \"train\")\n","    status = \"✅ SẴN SÀNG\" if os.path.exists(train_check) else \"❌ CHƯA THẤY\"\n","    print(f\"   {dset:15}: {train_check} -> {status}\")"]},{"cell_type":"code","execution_count":3,"id":"8fe94471","metadata":{"execution":{"iopub.execute_input":"2026-10-07T04:19:05.694203Z","iopub.status.busy":"2026-10-07T04:19:05.69407Z","iopub.status.idle":"2026-10-07T04:19:05.70366Z","shell.execute_reply":"2026-10-07T04:19:05.703447Z"},"papermill":{"duration":0.011784,"end_time":"2026-10-07T04:19:05.704115+00:00","exception":false,"start_time":"2026-10-07T04:19:05.692331+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["--- BẮT ĐẦU VÁ MÃ NGUỒN ---\n","✅ Đã cấu hình utils/data.py (Bao gồm cả vá CIFAR-100 Offline)\n","✅ Đã sửa import trunc_normal_ tại 1 file.\n","✅ Đã vá backbone/Lora_vit.py nạp weights ngoại tuyến thành công.\n"]}],"source":["# CELL 3: VÁ MÃ NGUỒN TỰ ĐỘNG (CODE PATCHING TOÀN DIỆN)\n","import os\n","import re\n","\n","# Đảm bảo làm việc đúng thư mục\n","if 'BASE_EXEC_DIR' not in globals():\n","    BASE_EXEC_DIR = \"/kaggle/working/GOD-Improvement/GOD\"\n","os.chdir(BASE_EXEC_DIR)\n","DATA_DIR = \"/kaggle/working/data\"\n","\n","print(\"--- BẮT ĐẦU VÁ MÃ NGUỒN ---\")\n","\n","# 1. Cập nhật đường dẫn dataset trong utils/data.py\n","data_py_path = \"utils/data.py\"\n","if os.path.exists(data_py_path):\n","    with open(data_py_path, \"r\") as f: data_code = f.read()\n","    data_code = data_code.replace(\"[DATA-PATH]\", DATA_DIR)\n","    \n","    path_mapping = {\n","        \"class iImageNetA\": {\"train\": f\"{DATA_DIR}/imagenet-a/train\", \"test\": f\"{DATA_DIR}/imagenet-a/test\"},\n","        \"class iImageNetR\": {\"train\": f\"{DATA_DIR}/imagenet-r/train\", \"test\": f\"{DATA_DIR}/imagenet-r/test\"},\n","        \"class omnibenchmark\": {\"train\": f\"{DATA_DIR}/omnibenchmark/train\", \"test\": f\"{DATA_DIR}/omnibenchmark/test\"},\n","        \"class CARS\": {\"train\": f\"{DATA_DIR}/cars/train\", \"test\": f\"{DATA_DIR}/cars/test\"},\n","                \"class CUB\": {\"train\": f\"{DATA_DIR}/cub_processed/train\", \"test\": f\"{DATA_DIR}/cub_processed/test\"},\n","        \"class mstar\": {\"train\": f\"{DATA_DIR}/mstar/train\", \"test\": f\"{DATA_DIR}/mstar/test\"},\n","        \"class nih_chest_xray\": {\"train\": f\"{DATA_DIR}/nih_chest_xray/train\", \"test\": f\"{DATA_DIR}/nih_chest_xray/test\"},\n","        \"class indian_pines\": {\"train\": f\"{DATA_DIR}/indian_pines/train\", \"test\": f\"{DATA_DIR}/indian_pines/test\"}\n","    }\n","    \n","    # Ép đường dẫn cứng vào từng class nếu cấu trúc codebase tách riêng\n","    for cls_name, paths in path_mapping.items():\n","        if cls_name in data_code:\n","            data_code = re.sub(rf'({cls_name}.*?train_dir\\s*=\\s*)[\"\\'].*?[\"\\']', rf'\\1\"{paths[\"train\"]}\"', data_code, flags=re.DOTALL)\n","            data_code = re.sub(rf'({cls_name}.*?test_dir\\s*=\\s*)[\"\\'].*?[\"\\']', rf'\\1\"{paths[\"test\"]}\"', data_code, flags=re.DOTALL)\n","            \n","    # [BỔ SUNG] Vá CIFAR-100 để chạy hoàn toàn Offline, không tải qua mạng\n","    if \"datasets.cifar.CIFAR100\" in data_code:\n","        data_code = data_code.replace(\"download=True\", \"download=False\")\n","        data_code = re.sub(\n","            r'datasets\\.cifar\\.CIFAR100\\(\\s*[\"\\'].*?[\"\\']', \n","            f'datasets.cifar.CIFAR100(\"{DATA_DIR}\"', \n","            data_code\n","        )\n","            \n","    with open(data_py_path, \"w\") as f: f.write(data_code)\n","    print(f\"✅ Đã cấu hình utils/data.py (Bao gồm cả vá CIFAR-100 Offline)\")\n","\n","# 2. Sửa lỗi import trunc_normal_ trong toàn bộ project\n","patched_imports = 0\n","for root, _, files in os.walk(\".\"):\n","    for file in files:\n","        if file.endswith(\".py\"):\n","            path = os.path.join(root, file)\n","            with open(path, \"r\", encoding=\"utf-8\", errors=\"ignore\") as f: txt = f.read()\n","            if \"from timm.models.layers.weight_init import trunc_normal_\" in txt:\n","                txt 