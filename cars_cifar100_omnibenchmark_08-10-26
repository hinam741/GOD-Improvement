n","        src_found = next((p for p in candidates if os.path.exists(p)), None)\n","        dst_link = os.path.join(WORK_DATA_DIR, name)\n","        if src_found and not os.path.exists(dst_link):\n","            os.symlink(src_found, dst_link)\n","    print(\"✅ Xong ImageNet-A, ImageNet-R, OmniBenchmark.\")\n","\n","    # 2.2. CUB-200 (Giải nén & Phân tách Train/Test)\n","    cub_tar = os.path.join(DATA_INPUT, \"CUB_200_2011.tgz\")\n","    cub_extract_dir = os.path.join(WORK_DATA_DIR, \"cub\")\n","    cub_raw = os.path.join(cub_extract_dir, \"CUB_200_2011\")\n","    cub_processed = os.path.join(WORK_DATA_DIR, \"cub_processed\")\n","    \n","    # Bước A: Giải nén\n","    if os.path.exists(cub_tar) and not os.path.exists(cub_raw):\n","        print(\"Đang giải nén CUB_200_2011 (~15 giây)...\")\n","        os.makedirs(cub_extract_dir, exist_ok=True)\n","        subprocess.run([\"tar\", \"-xzf\", cub_tar, \"-C\", cub_extract_dir], check=True)\n","    \n","    # Bước B: Đọc metadata và tạo Symlink phân tách train/test\n","    if os.path.exists(cub_raw) and not os.path.exists(os.path.join(cub_processed, \"train\")):\n","        print(\"Đang phân tách cấu trúc train/test cho CUB-200...\")\n","        os.makedirs(os.path.join(cub_processed, \"train\"), exist_ok=True)\n","        os.makedirs(os.path.join(cub_processed, \"test\"), exist_ok=True)\n","        \n","        with open(os.path.join(cub_raw, \"images.txt\"), \"r\") as f:\n","            images = dict(line.strip().split() for line in f)\n","        with open(os.path.join(cub_raw, \"train_test_split.txt\"), \"r\") as f:\n","            splits = dict(line.strip().split() for line in f)\n","            \n","        for img_id, rel_path in tqdm(images.items(), desc=\"Gán nhãn CUB-200\", ncols=80):\n","            split = \"train\" if splits[img_id] == \"1\" else \"test\"\n","            cls_name = rel_path.split(\"/\")[0]\n","            dst_folder = os.path.join(cub_processed, split, cls_name)\n","            os.makedirs(dst_folder, exist_ok=True)\n","            \n","            src_file = os.path.join(cub_raw, \"images\", rel_path)\n","            dst_file = os.path.join(dst_folder, os.path.basename(rel_path))\n","            if os.path.exists(src_file) and not os.path.exists(dst_file):\n","                os.symlink(src_file, dst_file)\n","        print(\"✅ Xử lý xong CUB-200.\")\n","    elif os.path.exists(os.path.join(cub_processed, \"train\")):\n","        print(\"✅ CUB-200 đã sẵn sàng.\")\n","\n","    # 2.3. Stanford Cars (Tối ưu I/O)\n","    cars_base = os.path.join(DATA_INPUT, \"StanfordCars-Dataset-main/StanfordCars-Dataset-main/stanford_cars\")\n","    cars_processed = os.path.join(WORK_DATA_DIR, \"cars\")\n","    if os.path.exists(cars_base) and not os.path.exists(os.path.join(cars_processed, \"train\", \"000\")):\n","        print(\"Đang chuẩn bị thư mục cho Stanford Cars...\")\n","        for split in [\"train\", \"test\"]:\n","            for i in range(196): os.makedirs(os.path.join(cars_processed, split, f\"{i:03d}\"), exist_ok=True)\n","        \n","        mat_file = os.path.join(cars_base, \"cars_annos.mat\")\n","        mat_data = scipy.io.loadmat(mat_file)\n","        train_src_dir, test_src_dir = os.path.join(cars_base, \"cars_train\"), os.path.join(cars_base, \"cars_test\")\n","        \n","        train_files = set(os.listdir(train_src_dir)) if os.path.exists(train_src_dir) else set()\n","        test_files = set(os.listdir(test_src_dir)) if os.path.exists(test_src_dir) else set()\n","        train_counter, test_counter = 0, 0\n","        \n","        print(\"Đang tạo symlink cho Stanford Cars...\")\n","        for global_idx, item in enumerate(tqdm(mat_data['annotations'][0], desc=\"Gán nhãn Cars\", ncols=80), start=1):\n","            rel_path = str(item['relative_im_path'].squeeze() if hasattr(item['relative_im_path'], 'squeeze') else item['relative_im_path'][0]).strip(\"['\\\"]\")\n","            base_name, class_id, is_test = os.path.basename(rel_path), int(item['class'][0][0]) - 1, int(item['test'][0][0])\n","            \n","            split, src_folder, files_set = (\"test\", test_src_dir, test_files) if is_test == 1 else (\"train\", train_src_dir, train_files)\n","            counter = test_counter + 1 if is_test == 1 else train_counter + 1\n","            if is_test == 1: test_counter += 1 \n","            else: train_counter += 1\n","                \n","            cls_folder = os.path.join(cars_processed, split, f\"{class_id:03d}\")\n","            candidates = [base_name, f\"{counter:05d}.jpg\", f\"{counter:06d}.jpg\", f\"{global_idx:05d}.jpg\", f\"{global_idx:06d}.jpg\"]\n","            found_name = next((c for c in candidates if c in files_set), None)\n","            if found_name:\n","                dst_file = os.path.join(cls_folder, found_name)\n","                if not os.path.exists(dst_file): os.symlink(os.path.join(src_folder, found_name), dst_file)\n","        print(\"✅ Xử lý xong Stanford Cars.\")\n","    else:\n","        print(\"✅ Stanford Cars đã sẵn sàng.\")\n","\n","print(\"\\n--- 3. XỬ LÝ CIFAR-100 OFFLINE ---\")\n","cifar_offline_path = None\n","for root, dirs, files in os.walk(\"/kaggle/input\"):\n","    if \"cifar-100-python\" in dirs:\n","        cifar_offline_path = os.path.join(root, \"cifar-100-python\")\n","        break\n","    elif \"cifar-100-python.tar.gz\" in files:\n","        cifar_offline_path = os.path.join(root, \"cifar-100-python.tar.gz\")\n","        break\n","\n","if cifar_offline_path:\n","    # 3.1. Chuyển CIFAR vào working data\n","    if cifar_offline_path.endswith(\".tar.gz\"):\n","        target_tar = os.path.join(WORK_DATA_DIR, \"cifar-100-python.tar.gz\")\n","        if not os.path.exists(target_tar): os.symlink(cifar_offline_path, target_tar)\n","    else:\n","        target_dir = os.path.join(WORK_DATA_DIR, \"cifar-100-python\")\n","        if not os.path.exists(target_dir): os.symlink(cifar_offline_path, target_dir)\n","    print(\"✅ Đã liên kết CIFA